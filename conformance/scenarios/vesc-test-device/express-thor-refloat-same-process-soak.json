{
  "schemaVersion": 1,
  "id": "express-thor-refloat-same-process-soak",
  "description": "R8 twenty repeated ride cycles in one Android instrumentation process",
  "advertisement": {
    "name": "FloatView Test VESC",
    "manufacturerMarkerHex": "ffff46565431",
    "profile": "canonicalVescUart"
  },
  "topology": {
    "transport": { "hardwareName": "VESC Express T", "firmware": "6.05" },
    "canNodes": [
      {
        "canId": 42,
        "role": "primary",
        "hardwareName": "THOR300",
        "firmware": "6.06"
      }
    ],
    "primaryCanId": 42,
    "refloat": { "packageVersion": "1.2.3" }
  },
  "rules": [
    {
      "id": "transportFirmware",
      "match": { "kind": "transportFirmware" },
      "occurrences": { "minimum": 20, "maximum": 20 },
      "response": {
        "fixture": "fixtures/vesc/firmware-express-6.05.json",
        "chunking": { "mode": "fixture" }
      }
    },
    {
      "id": "canPing",
      "match": { "kind": "canPing" },
      "occurrences": { "minimum": 20, "maximum": 20 },
      "response": {
        "payloadHex": "3e2a",
        "provenance": "COMM_PING_CAN response layout from pinned VESC Tool with the scenario's single CAN node",
        "chunking": { "mode": "single" }
      }
    },
    {
      "id": "primaryFirmware",
      "match": { "kind": "primaryFirmware", "canId": 42 },
      "occurrences": { "minimum": 20, "maximum": 20 },
      "response": {
        "fixture": "fixtures/vesc/firmware-6.06.json",
        "chunking": { "mode": "fixture" }
      }
    },
    {
      "id": "refloatInfo",
      "match": { "kind": "refloatInfo", "canId": 42 },
      "occurrences": { "minimum": 20, "maximum": 20 },
      "response": {
        "fixture": "fixtures/refloat/rtdata-1.2.3-android-hardware.json",
        "case": "versioned-info-v2",
        "chunking": { "mode": "fixture" }
      }
    },
    {
      "id": "refloatTelemetryIds",
      "match": { "kind": "refloatTelemetryIds", "canId": 42 },
      "occurrences": { "minimum": 20, "maximum": 60 },
      "response": {
        "fixture": "fixtures/refloat/rtdata-1.2.3-android-hardware.json",
        "case": "dynamic-realtime-field-ids",
        "chunking": {
          "mode": "sizes",
          "sizes": [
            20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20,
            20, 20, 20, 12
          ],
          "interChunkDelayMs": 10
        }
      }
    },
    {
      "id": "refloatTelemetry",
      "match": { "kind": "refloatTelemetry", "canId": 42 },
      "occurrences": { "minimum": 3360, "maximum": 3360 },
      "repeatEveryOccurrences": 168,
      "responses": [
        {
          "fromOccurrence": 1,
          "toOccurrence": 3,
          "phase": "idle",
          "outcome": {
            "fixture": "fixtures/refloat/ride-states-1.2.3.json",
            "case": "idle",
            "chunking": { "mode": "fixture" }
          }
        },
        {
          "fromOccurrence": 4,
          "toOccurrence": 8,
          "phase": "riding",
          "outcome": {
            "fixture": "fixtures/refloat/ride-states-1.2.3.json",
            "case": "riding",
            "chunking": { "mode": "fixture" }
          }
        },
        {
          "fromOccurrence": 9,
          "toOccurrence": 9,
          "phase": "footpadWarning",
          "outcome": {
            "fixture": "fixtures/refloat/ride-states-1.2.3.json",
            "case": "footpad-warning",
            "chunking": { "mode": "fixture" }
          }
        },
        {
          "fromOccurrence": 10,
          "toOccurrence": 12,
          "phase": "riding",
          "outcome": {
            "fixture": "fixtures/refloat/ride-states-1.2.3.json",
            "case": "riding",
            "chunking": { "mode": "fixture" }
          }
        },
        {
          "fromOccurrence": 13,
          "toOccurrence": 163,
          "phase": "postRideTail",
          "outcome": {
            "fixture": "fixtures/refloat/ride-states-1.2.3.json",
            "case": "post-ride-tail",
            "chunking": { "mode": "fixture" }
          }
        },
        {
          "fromOccurrence": 164,
          "toOccurrence": 168,
          "phase": "returnToIdle",
          "outcome": {
            "fixture": "fixtures/refloat/ride-states-1.2.3.json",
            "case": "return-to-idle",
            "chunking": { "mode": "fixture" }
          }
        }
      ]
    }
  ],
  "expectations": {
    "orderedRuleIds": [
      "transportFirmware",
      "canPing",
      "primaryFirmware",
      "refloatInfo",
      "refloatTelemetryIds",
      "refloatTelemetry"
    ],
    "cadence": [
      {
        "ruleId": "refloatTelemetry",
        "fromOccurrence": 2,
        "toOccurrence": 4,
        "intervalMs": 500,
        "toleranceMs": 250,
        "phase": "idleProbe",
        "repeatEveryOccurrences": 168,
        "repeatCount": 20
      },
      {
        "ruleId": "refloatTelemetry",
        "fromOccurrence": 6,
        "toOccurrence": 164,
        "intervalMs": 100,
        "toleranceMs": 120,
        "phase": "ridingAndTailProbe",
        "repeatEveryOccurrences": 168,
        "repeatCount": 20
      },
      {
        "ruleId": "refloatTelemetry",
        "fromOccurrence": 167,
        "toOccurrence": 168,
        "intervalMs": 500,
        "toleranceMs": 250,
        "phase": "returnToIdleProbe",
        "repeatEveryOccurrences": 168,
        "repeatCount": 20
      }
    ]
  },
  "limits": {
    "maxTranscriptEntries": 50000,
    "maxBufferedBytes": 8192,
    "commandTimeoutMs": 3000
  }
}
