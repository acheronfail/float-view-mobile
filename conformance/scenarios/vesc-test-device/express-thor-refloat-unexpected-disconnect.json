{
  "schemaVersion": 1,
  "id": "express-thor-refloat-unexpected-disconnect",
  "description": "T3 deterministic host-commanded disconnect during riding through VESC Express and Thor300",
  "advertisement": {
    "name": "FloatView Test VESC",
    "manufacturerMarkerHex": "ffff46565431",
    "profile": "canonicalVescUart"
  },
  "topology": {
    "transport": {
      "hardwareName": "VESC Express T",
      "firmware": "6.05"
    },
    "canNodes": [
      {
        "canId": 42,
        "role": "primary",
        "hardwareName": "THOR300",
        "firmware": "6.06"
      }
    ],
    "primaryCanId": 42,
    "refloat": {
      "packageVersion": "1.2.3"
    }
  },
  "rules": [
    {
      "id": "transportFirmware",
      "match": { "kind": "transportFirmware" },
      "occurrences": { "minimum": 1, "maximum": 1 },
      "response": {
        "fixture": "fixtures/vesc/firmware-express-6.05.json",
        "chunking": { "mode": "fixture" }
      }
    },
    {
      "id": "canPing",
      "match": { "kind": "canPing" },
      "occurrences": { "minimum": 1, "maximum": 1 },
      "response": {
        "payloadHex": "3e2a",
        "provenance": "COMM_PING_CAN response layout from pinned VESC Tool with the scenario's single CAN node",
        "chunking": { "mode": "single" }
      }
    },
    {
      "id": "primaryFirmware",
      "match": { "kind": "primaryFirmware", "canId": 42 },
      "occurrences": { "minimum": 1, "maximum": 1 },
      "response": {
        "fixture": "fixtures/vesc/firmware-6.06.json",
        "chunking": { "mode": "fixture" }
      }
    },
    {
      "id": "refloatInfo",
      "match": { "kind": "refloatInfo", "canId": 42 },
      "occurrences": { "minimum": 1, "maximum": 1 },
      "response": {
        "fixture": "fixtures/refloat/rtdata-1.2.3-android-hardware.json",
        "case": "versioned-info-v2",
        "chunking": { "mode": "fixture" }
      }
    },
    {
      "id": "refloatTelemetryIds",
      "match": { "kind": "refloatTelemetryIds", "canId": 42 },
      "occurrences": { "minimum": 1, "maximum": 3 },
      "response": {
        "fixture": "fixtures/refloat/rtdata-1.2.3-android-hardware.json",
        "case": "dynamic-realtime-field-ids",
        "chunking": {
          "mode": "sizes",
          "sizes": [
            20, 20, 20, 20, 20, 20, 20,
            20, 20, 20, 20, 20, 20, 20,
            20, 20, 20, 20, 20, 20, 12
          ],
          "interChunkDelayMs": 10
        }
      }
    },
    {
      "id": "refloatTelemetry",
      "match": { "kind": "refloatTelemetry", "canId": 42 },
      "occurrences": { "minimum": 6, "maximum": 6 },
      "responses": [
        {
          "fromOccurrence": 1,
          "toOccurrence": 2,
          "phase": "idle",
          "outcome": {
            "fixture": "fixtures/refloat/ride-states-1.2.3.json",
            "case": "idle",
            "chunking": { "mode": "fixture" }
          }
        },
        {
          "fromOccurrence": 3,
          "toOccurrence": 5,
          "phase": "riding",
          "outcome": {
            "fixture": "fixtures/refloat/ride-states-1.2.3.json",
            "case": "riding",
            "chunking": { "mode": "fixture" }
          }
        },
        {
          "fromOccurrence": 6,
          "toOccurrence": 6,
          "phase": "unexpectedDisconnect",
          "outcome": { "action": "disconnect" }
        }
      ]
    }
  ],
  "expectations": {
    "orderedRuleIds": [
      "transportFirmware",
      "canPing",
      "primaryFirmware",
      "refloatInfo",
      "refloatTelemetryIds",
      "refloatTelemetry"
    ],
    "cadence": [
      {
        "ruleId": "refloatTelemetry",
        "fromOccurrence": 2,
        "toOccurrence": 3,
        "intervalMs": 500,
        "toleranceMs": 250,
        "phase": "idleProbe"
      },
      {
        "ruleId": "refloatTelemetry",
        "fromOccurrence": 4,
        "toOccurrence": 6,
        "intervalMs": 100,
        "toleranceMs": 80,
        "phase": "ridingProbeUntilDisconnect"
      }
    ]
  },
  "limits": {
    "maxTranscriptEntries": 1024,
    "maxBufferedBytes": 8192,
    "commandTimeoutMs": 3000
  }
}
