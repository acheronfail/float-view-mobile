{
  "name": "float-view-conformance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc --noEmit && npm run fixture:check",
    "test": "node --strip-types --test test/**/*.test.ts fixture-dev/src/lib/*.spec.ts fixture-dev/src/lib/coordinator/*.spec.ts fixture-dev/src/lib/control/*.spec.ts",
    "fixture:dev": "cd fixture-dev && vite dev",
    "fixture:check": "cd fixture-dev && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "direct": "node --strip-types src/run.ts direct",
    "mock": "node --strip-types src/run.ts mock",
    "macos": "node --strip-types src/run.ts macos",
    "ios": "node --strip-types src/run.ts ios",
    "android": "node --strip-types src/run.ts android",
    "physical": "node --strip-types src/run.ts physical",
    "measure": "node --strip-types src/measure.ts",
    "generate-session": "node --strip-types src/generate-session.ts",
    "format:check": "prettier --check --ignore-path ../.prettierignore \"../**/*.{js,cjs,mjs,jsx,ts,tsx,svelte,css,html,md}\"",
    "format:write": "prettier --write --ignore-path ../.prettierignore \"../**/*.{js,cjs,mjs,jsx,ts,tsx,svelte,css,html,md}\"",
    "startup": "node --strip-types --test test/startup-rendering.browser.ts test/ride-markers.browser.ts",
    "test:live-viewports": "npm --prefix ../frontend run build && node --strip-types --test test/live-viewports.browser.ts",
    "startup:android": "node --strip-types src/startup-android.ts"
  },
  "dependencies": {
    "serialport": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
