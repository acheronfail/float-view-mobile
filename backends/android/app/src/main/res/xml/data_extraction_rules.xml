<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="float-view/logs/" />
        <exclude domain="file" path="float-view/logs/Exports" />
        <exclude domain="file" path="float-view/logs/refloat-schema-cache" />
        <exclude domain="file" path="float-view/logs/.service.lock" />
        <exclude domain="file" path="float-view/logs/.service.lock-journal" />
        <exclude domain="file" path="float-view/logs/.service.lock-wal" />
        <exclude domain="file" path="float-view/logs/.service.lock-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="float-view/logs/" />
        <exclude domain="file" path="float-view/logs/Exports" />
        <exclude domain="file" path="float-view/logs/refloat-schema-cache" />
        <exclude domain="file" path="float-view/logs/.service.lock" />
        <exclude domain="file" path="float-view/logs/.service.lock-journal" />
        <exclude domain="file" path="float-view/logs/.service.lock-wal" />
        <exclude domain="file" path="float-view/logs/.service.lock-shm" />
    </device-transfer>
</data-extraction-rules>
