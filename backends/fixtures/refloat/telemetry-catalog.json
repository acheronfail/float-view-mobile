{
  "schemaVersion": 1,
  "id": "refloat-normalized-telemetry-catalog",
  "provenance": [
    "https://github.com/lukash/refloat/tree/v1.0.0",
    "https://github.com/lukash/refloat/tree/v1.1.0",
    "https://github.com/lukash/refloat/tree/v1.2.3"
  ],
  "bounds": {
    "layoutFields": 64,
    "fieldNameUtf8Bytes": 64,
    "aggregateFieldNameUtf8Bytes": 4096,
    "extensionFields": 32,
    "typedDetailUtf8Bytes": 16384,
    "extensionJsonUtf8Bytes": 16384,
    "messageBytes": 65536,
    "scenarioDocumentUtf8Bytes": 65536,
    "diagnostics": 50,
    "seriesPoints": 2000,
    "transitionEvents": 2000
  },
  "numericFields": {
    "speedKph": { "unit": "km/h", "nullable": true },
    "erpm": { "unit": "electrical rpm", "nullable": true },
    "pitchDeg": { "unit": "deg", "nullable": true },
    "balancePitchDeg": { "unit": "deg", "nullable": true },
    "rollDeg": { "unit": "deg", "nullable": true },
    "motorCurrentA": { "unit": "A", "nullable": true },
    "directionalMotorCurrentA": { "unit": "A", "nullable": true },
    "filteredMotorCurrentA": { "unit": "A", "nullable": true },
    "batteryCurrentA": { "unit": "A", "nullable": true },
    "requestedBalanceCurrentA": { "unit": "A", "nullable": true },
    "boosterCurrentA": { "unit": "A", "nullable": true },
    "fieldWeakeningCurrentA": { "unit": "A", "nullable": true },
    "dutyCycle": { "unit": "ratio", "nullable": true },
    "packVoltageV": { "unit": "V", "nullable": true },
    "controllerTempC": { "unit": "deg C", "nullable": true },
    "motorTempC": { "unit": "deg C", "nullable": true },
    "footpadAdc1V": { "unit": "V", "nullable": true },
    "footpadAdc2V": { "unit": "V", "nullable": true },
    "remoteInput": { "unit": "ratio", "nullable": true },
    "setpointDeg": { "unit": "deg", "nullable": true },
    "atrSetpointDeg": { "unit": "deg", "nullable": true },
    "brakeTiltSetpointDeg": { "unit": "deg", "nullable": true },
    "torqueTiltSetpointDeg": { "unit": "deg", "nullable": true },
    "turnTiltSetpointDeg": { "unit": "deg", "nullable": true },
    "remoteSetpointDeg": { "unit": "deg", "nullable": true },
    "atrAccelerationDifferenceErpmPerSecond": {
      "unit": "electrical rpm/s",
      "nullable": true
    },
    "atrSpeedBoost": { "unit": "ratio", "nullable": true },
    "distanceM": { "unit": "m", "nullable": true },
    "odometerM": { "unit": "m", "nullable": true },
    "ampHoursDrawnAh": { "unit": "Ah", "nullable": true },
    "ampHoursChargedAh": { "unit": "Ah", "nullable": true },
    "wattHoursDrawnWh": { "unit": "Wh", "nullable": true },
    "wattHoursChargedWh": { "unit": "Wh", "nullable": true },
    "batteryLevel": { "unit": "ratio", "nullable": true },
    "chargingCurrentA": { "unit": "A", "nullable": true },
    "chargingVoltageV": { "unit": "V", "nullable": true }
  },
  "stateFields": {
    "packageState": ["disabled", "startup", "ready", "running", "unknown"],
    "packageMode": ["normal", "handTest", "flywheel", "unknown"],
    "footpadState": ["none", "left", "right", "both", "unknown"],
    "stopCondition": [
      "none",
      "pitch",
      "roll",
      "switchHalf",
      "switchFull",
      "reverseStop",
      "quickStop",
      "unknown"
    ],
    "setpointAdjustment": [
      "none",
      "centering",
      "reverseStop",
      "speed",
      "duty",
      "error",
      "highVoltage",
      "lowVoltage",
      "temperature",
      "unknown"
    ],
    "alertReason": [
      "none",
      "lowVoltage",
      "highVoltage",
      "controllerTemperature",
      "motorTemperature",
      "current",
      "duty",
      "sensors",
      "lowBattery",
      "idle",
      "error",
      "speed",
      "cellUnderTemperature",
      "cellOverTemperature",
      "cellLowVoltage",
      "cellHighVoltage",
      "cellImbalance",
      "bmsConnection",
      "bmsOverTemperature",
      "firmwareFault",
      "unknown"
    ],
    "firmwareFault": [
      "overVoltage",
      "underVoltage",
      "driver",
      "absoluteOverCurrent",
      "controllerOverTemperature",
      "motorOverTemperature",
      "gateDriverOverVoltage",
      "gateDriverUnderVoltage",
      "mcuUnderVoltage",
      "watchdogReset",
      "encoderSpi",
      "encoderSinCosBelowMinimum",
      "encoderSinCosAboveMaximum",
      "flashCorruption",
      "currentSensorOffset1",
      "currentSensorOffset2",
      "currentSensorOffset3",
      "unbalancedCurrents",
      "brake",
      "resolverLossOfTracking",
      "resolverDegradationOfSignal",
      "resolverLossOfSignal",
      "appConfigFlashCorruption",
      "motorConfigFlashCorruption",
      "encoderNoMagnet",
      "encoderMagnetTooStrong",
      "phaseFilter",
      "unknown"
    ]
  },
  "transitionOrder": [
    "packageState",
    "packageMode",
    "footpadState",
    "stopCondition",
    "setpointAdjustment",
    "wheelslip",
    "darkride",
    "charging",
    "alertReason",
    "firmwareFault"
  ],
  "equivalenceCase": {
    "packageState": "running",
    "packageMode": "normal",
    "footpadState": "both",
    "speedKph": 21.6,
    "erpm": 5000,
    "pitchDeg": 1.5,
    "balancePitchDeg": 1.25,
    "rollDeg": -0.5,
    "motorCurrentA": 24,
    "batteryCurrentA": 10,
    "dutyCycle": 0.5,
    "packVoltageV": 62,
    "controllerTempC": 34,
    "motorTempC": 32
  }
}
