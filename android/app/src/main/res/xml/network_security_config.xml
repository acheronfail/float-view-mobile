<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic only for localhost/loopback addresses -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain> <!-- Android emulator host -->
    </domain-config>

    <!-- Default configuration for all other domains -->
    <base-config cleartextTrafficPermitted="false">
        <!-- Require HTTPS for all external connections -->
        <trust-anchors>
            <!-- Trust system certificate authorities -->
            <certificates src="system"/>
            <!-- Optionally trust user-added CAs (be careful with this in production) -->
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
