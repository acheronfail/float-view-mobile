{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://float-view.local/schemas/vesc-test-device/scenario-v1.schema.json",
  "title": "Float View VESC test-device scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "description", "advertisement", "topology", "rules", "expectations", "limits"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "description": { "type": "string", "minLength": 1 },
    "advertisement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "manufacturerMarkerHex", "profile"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 29 },
        "manufacturerMarkerHex": { "$ref": "#/$defs/hex" },
        "profile": { "const": "canonicalVescUart" }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "canNodes", "primaryCanId", "refloat"],
      "properties": {
        "transport": { "$ref": "#/$defs/device" },
        "canNodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["canId", "role", "hardwareName", "firmware"],
            "properties": {
              "canId": { "type": "integer", "minimum": 0, "maximum": 254 },
              "role": { "type": "string", "minLength": 1 },
              "hardwareName": { "type": "string", "minLength": 1 },
              "firmware": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
            }
          }
        },
        "primaryCanId": { "type": "integer", "minimum": 0, "maximum": 254 },
        "refloat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packageVersion"],
          "properties": { "packageVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/rule" }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderedRuleIds"],
      "properties": {
        "orderedRuleIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cadence": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/cadenceExpectation" }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxTranscriptEntries", "maxBufferedBytes", "commandTimeoutMs"],
      "properties": {
        "maxTranscriptEntries": { "type": "integer", "minimum": 16, "maximum": 100000 },
        "maxBufferedBytes": { "type": "integer", "minimum": 256, "maximum": 8192 },
        "commandTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{2})+$" },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardwareName", "firmware"],
      "properties": {
        "hardwareName": { "type": "string", "minLength": 1 },
        "firmware": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["transportFirmware", "canPing", "primaryFirmware", "refloatInfo", "refloatTelemetryIds", "refloatTelemetry"]
        },
        "canId": { "type": "integer", "minimum": 0, "maximum": 254 }
      }
    },
    "chunking": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "fixture" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "single" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "sizes"],
          "properties": {
            "mode": { "const": "sizes" },
            "sizes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": { "type": "integer", "minimum": 1, "maximum": 244 }
            },
            "interChunkDelayMs": { "type": "integer", "minimum": 0, "maximum": 5000 }
          }
        }
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixture", "chunking"],
          "properties": {
            "fixture": { "type": "string", "pattern": "^fixtures/(?:vesc|refloat)/[a-zA-Z0-9._-]+\\.json$" },
            "case": { "type": "string", "minLength": 1 },
            "chunking": { "$ref": "#/$defs/chunking" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["payloadHex", "provenance", "chunking"],
          "properties": {
            "payloadHex": { "$ref": "#/$defs/hex" },
            "provenance": { "type": "string", "minLength": 1 },
            "chunking": { "$ref": "#/$defs/chunking" }
          }
        }
      ]
    },
    "occurrenceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromOccurrence", "phase", "outcome"],
      "properties": {
        "fromOccurrence": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "toOccurrence": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "phase": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]+$" },
        "outcome": {
          "oneOf": [
            { "$ref": "#/$defs/response" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["action"],
              "properties": { "action": { "const": "disconnect" } }
            }
          ]
        }
      }
    },
    "cadenceExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "fromOccurrence", "toOccurrence", "intervalMs", "toleranceMs", "phase"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]+$" },
        "fromOccurrence": { "type": "integer", "minimum": 2, "maximum": 100000 },
        "toOccurrence": { "type": "integer", "minimum": 2, "maximum": 100000 },
        "intervalMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "toleranceMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "phase": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]+$" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "occurrences"],
      "oneOf": [
        {
          "required": ["response"],
          "properties": { "response": {} },
          "not": {
            "required": ["responses"],
            "properties": { "responses": {} }
          }
        },
        {
          "required": ["responses"],
          "properties": { "responses": {} },
          "not": {
            "required": ["response"],
            "properties": { "response": {} }
          }
        }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]+$" },
        "match": { "$ref": "#/$defs/match" },
        "occurrences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "maximum": { "type": "integer", "minimum": 1, "maximum": 100000 }
          }
        },
        "response": { "$ref": "#/$defs/response" },
        "responses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/occurrenceResponse" }
        }
      }
    }
  }
}
