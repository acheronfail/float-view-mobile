{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://float-view.local/schemas/vesc-test-device/control-v1.schema.json",
  "title": "Float View VESC test-device USB control envelope v1",
  "oneOf": [
    {
      "type": "object",
      "required": ["protocolVersion", "sequence", "kind"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "kind": {
          "enum": ["hello", "reset", "configureGattProfile", "startAdvertising", "stopAdvertising", "setWritePolicy", "notify", "disconnect", "getState"]
        }
      }
    },
    {
      "type": "object",
      "required": ["protocolVersion", "sequence", "kind", "uptimeMs"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "uptimeMs": { "type": "integer", "minimum": 0 }
      }
    }
  ]
}
