{
  "name": "@float-view/vesc-test-device-host",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "verify:macos": "node --import tsx src/verify-macos.ts",
    "verify:macos:ride": "node --import tsx src/verify-macos-ride.ts",
    "verify:macos:unexpected-disconnect": "node --import tsx src/verify-macos-ride.ts --mode unexpected-disconnect",
    "verify:android:ride": "node --import tsx src/verify-android.ts",
    "verify:android:unexpected-disconnect": "node --import tsx src/verify-android.ts --mode unexpected-disconnect",
    "verify:ios:ride": "node --import tsx src/verify-ios.ts",
    "verify:ios:unexpected-disconnect": "node --import tsx src/verify-ios.ts --mode unexpected-disconnect"
  },
  "dependencies": {
    "@serialport/bindings-interface": "^1.2.2",
    "ajv": "^8.20.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2"
  }
}
