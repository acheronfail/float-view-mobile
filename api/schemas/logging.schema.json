{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://float-view.local/api/v1/schemas/logging.schema.json",
  "title": "Float View logging API types",
  "$defs": {
    "LoggingJobState": {
      "type": "string",
      "enum": ["starting", "running", "stopping", "stopped", "failed"]
    },
    "LoggingJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "deviceId",
        "state",
        "requestedIntervalMs",
        "effectiveIntervalMs",
        "sampleCount",
        "errorCount",
        "bytesWritten"
      ],
      "properties": {
        "jobId": { "type": "string", "minLength": 1 },
        "deviceId": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/LoggingJobState" },
        "requestedIntervalMs": {
          "type": "integer",
          "minimum": 20,
          "maximum": 60000
        },
        "effectiveIntervalMs": {
          "type": "integer",
          "minimum": 20,
          "maximum": 60000
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "stoppedAt": { "type": "string", "format": "date-time" },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "errorCount": { "type": "integer", "minimum": 0 },
        "bytesWritten": { "type": "integer", "minimum": 0 },
        "backgroundCapable": { "type": "boolean" },
        "lastError": { "$ref": "common.schema.json#/$defs/RpcErrorData" }
      }
    }
  },
  "$ref": "#/$defs/LoggingJob"
}
