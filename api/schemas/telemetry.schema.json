{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://float-view.local/api/v1/schemas/telemetry.schema.json",
  "title": "Float View telemetry API types",
  "$defs": {
    "TelemetryProfile": {
      "type": "string",
      "enum": ["vesc_realtime", "refloat_realtime"]
    },
    "TelemetrySubscription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subscriptionId", "deviceId", "profile", "intervalMs"],
      "properties": {
        "subscriptionId": { "type": "string", "minLength": 1 },
        "deviceId": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/TelemetryProfile" },
        "intervalMs": { "type": "integer", "minimum": 20, "maximum": 60000 },
        "fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
  "$ref": "#/$defs/TelemetrySubscription"
}
