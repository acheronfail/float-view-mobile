{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://float-view.local/api/v1/schemas/product.schema.json",
  "title": "Float View product API",
  "$defs": {
    "EmptyParams": {
      "type": "object",
      "additionalProperties": false
    },
    "AcceptedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted"],
      "properties": { "accepted": { "type": "boolean" } }
    },
    "SavedDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["savedDeviceId", "deviceHistoryId", "displayName", "profileComplete"],
      "properties": {
        "savedDeviceId": { "type": "string", "minLength": 1 },
        "deviceHistoryId": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "advertisedName": { "type": ["string", "null"] },
        "lastSeenAt": { "type": ["string", "null"], "format": "date-time" },
        "lastConnectedAt": { "type": ["string", "null"], "format": "date-time" },
        "profileComplete": { "type": "boolean" }
      }
    },
    "BoardProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["savedDeviceId", "revision", "values", "missingFields"],
      "properties": {
        "savedDeviceId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "values": { "type": "object", "additionalProperties": true },
        "missingFields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "SessionState": {
      "type": "string",
      "enum": ["active", "completed", "interrupted", "partial", "failed"]
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "deviceHistoryId",
        "displayName",
        "startedAt",
        "state",
        "integrity",
        "sampleCount",
        "eventCount",
        "ridingElapsedMs",
        "totalElapsedMs"
      ],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "deviceHistoryId": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": ["string", "null"], "format": "date-time" },
        "state": { "$ref": "#/$defs/SessionState" },
        "integrity": {
          "type": "string",
          "enum": ["complete", "gaps", "recovered", "corrupt"]
        },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "eventCount": { "type": "integer", "minimum": 0 },
        "ridingElapsedMs": { "type": "integer", "minimum": 0 },
        "totalElapsedMs": { "type": "integer", "minimum": 0 },
        "distanceM": { "type": ["number", "null"] },
        "maxSpeedMps": { "type": ["number", "null"] },
        "maxDutyCycle": { "type": ["number", "null"] }
      }
    },
    "SessionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionGroupId", "deviceHistoryId", "sessionIds", "totalElapsedMs"],
      "properties": {
        "sessionGroupId": { "type": "string", "minLength": 1 },
        "deviceHistoryId": { "type": "string", "minLength": 1 },
        "sessionIds": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "totalElapsedMs": { "type": "integer", "minimum": 0 },
        "distanceM": { "type": ["number", "null"] }
      }
    },
    "Settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "idleProbeIntervalMs",
        "idlePersistIntervalMs",
        "ridingPersistIntervalMs",
        "postRideTailMs",
        "reconnectDurationMs",
        "automaticSessionLinkingEnabled",
        "sessionLinkWindowMs",
        "rawPacketCaptureEnabled"
      ],
      "properties": {
        "revision": { "type": "integer", "minimum": 0 },
        "idleProbeIntervalMs": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "idlePersistIntervalMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "ridingPersistIntervalMs": { "type": "integer", "minimum": 50, "maximum": 10000 },
        "postRideTailMs": { "type": "integer", "minimum": 0, "maximum": 300000 },
        "reconnectDurationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "automaticSessionLinkingEnabled": { "type": "boolean" },
        "sessionLinkWindowMs": {
          "type": "integer",
          "minimum": 60000,
          "maximum": 86400000
        },
        "rawPacketCaptureEnabled": { "type": "boolean" }
      }
    },
    "SettingsPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "idleProbeIntervalMs": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "idlePersistIntervalMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "ridingPersistIntervalMs": { "type": "integer", "minimum": 50, "maximum": 10000 },
        "postRideTailMs": { "type": "integer", "minimum": 0, "maximum": 300000 },
        "reconnectDurationMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "automaticSessionLinkingEnabled": { "type": "boolean" },
        "sessionLinkWindowMs": { "type": "integer", "minimum": 60000, "maximum": 86400000 },
        "rawPacketCaptureEnabled": { "type": "boolean" }
      }
    },
    "AlertRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "kind", "enabled", "threshold", "cooldownMs"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "duty_high",
            "voltage_low",
            "voltage_high",
            "motor_temperature_high",
            "controller_temperature_high",
            "footpad",
            "connection_loss"
          ]
        },
        "enabled": { "type": "boolean" },
        "threshold": { "type": ["number", "null"] },
        "durationMs": { "type": "integer", "minimum": 0 },
        "hysteresis": { "type": "number", "minimum": 0 },
        "cooldownMs": { "type": "integer", "minimum": 0 }
      }
    },
    "StorageState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availableBytes", "level", "warningBytes", "criticalBytes", "stopBytes"],
      "properties": {
        "availableBytes": { "type": "integer", "minimum": 0 },
        "level": {
          "type": "string",
          "enum": ["normal", "warning", "critical", "stop"]
        },
        "warningBytes": { "type": "integer", "minimum": 0 },
        "criticalBytes": { "type": "integer", "minimum": 0 },
        "stopBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "FirmwareInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vescVersion", "packageName", "packageVersion", "supported"],
      "properties": {
        "vescVersion": { "type": "string" },
        "packageName": { "type": "string" },
        "packageVersion": { "type": "string" },
        "hardwareName": { "type": ["string", "null"] },
        "supported": { "type": "boolean" }
      }
    },
    "SeriesPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsedMs", "values"],
      "properties": {
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "values": {
          "type": "object",
          "additionalProperties": { "type": ["number", "null"] }
        }
      }
    },
    "SessionSeriesField": {
      "type": "string",
      "enum": [
        "packVoltageV",
        "dutyCycle",
        "controllerTempC",
        "motorTempC",
        "footpadState",
        "motorCurrentA",
        "batteryCurrentA",
        "erpm",
        "speedKph"
      ]
    },
    "SessionListFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deviceHistoryId": { "type": "string", "minLength": 1 },
        "startedAfter": { "type": "string", "format": "date-time" },
        "startedBefore": { "type": "string", "format": "date-time" },
        "minimumRidingElapsedMs": { "type": "integer", "minimum": 0 },
        "maximumRidingElapsedMs": { "type": "integer", "minimum": 0 },
        "minimumTotalElapsedMs": { "type": "integer", "minimum": 0 },
        "maximumTotalElapsedMs": { "type": "integer", "minimum": 0 },
        "minimumDistanceM": { "type": "number", "minimum": 0 },
        "maximumDistanceM": { "type": "number", "minimum": 0 },
        "state": { "$ref": "#/$defs/SessionState" },
        "integrity": {
          "type": "string",
          "enum": ["complete", "gaps", "recovered", "corrupt"]
        }
      }
    },
    "SessionListSort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "direction"],
      "properties": {
        "field": {
          "type": "string",
          "enum": ["startedAt", "ridingElapsedMs", "totalElapsedMs", "distanceM"]
        },
        "direction": { "type": "string", "enum": ["asc", "desc"] }
      }
    },
    "SessionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "elapsedMs", "kind", "details"],
      "properties": {
        "eventId": { "type": "string" },
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string" },
        "details": { "type": "object", "additionalProperties": true }
      }
    },
    "CursorPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "nextCursor"],
      "properties": {
        "items": { "type": "array", "items": {} },
        "nextCursor": { "type": ["string", "null"] }
      }
    },
    "BluetoothGetStateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "bluetooth.getState" },
        "params": { "$ref": "#/$defs/EmptyParams" }
      }
    },
    "BluetoothGetStateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": { "$ref": "bluetooth.schema.json#/$defs/BluetoothState" }
      }
    },
    "BluetoothRequestPermissionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "bluetooth.requestPermission" },
        "params": { "$ref": "#/$defs/EmptyParams" }
      }
    },
    "BluetoothRequestPermissionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": { "$ref": "bluetooth.schema.json#/$defs/BluetoothState" }
      }
    },
    "DiscoveryStartRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "discovery.start" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "timeoutMs": { "type": "integer", "minimum": 100 } }
        }
      }
    },
    "DiscoveryStartResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scanId"],
          "properties": { "scanId": { "type": "string" } }
        }
      }
    },
    "DiscoveryStopRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "discovery.stop" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scanId"],
          "properties": { "scanId": { "type": "string" } }
        }
      }
    },
    "DiscoveryStopResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": { "$ref": "#/$defs/AcceptedResult" }
      }
    },
    "DeviceConnectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "device.connect" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deviceId"],
          "properties": {
            "deviceId": { "type": "string" },
            "timeoutMs": { "type": "integer", "minimum": 100 }
          }
        }
      }
    },
    "DeviceConnectResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": { "$ref": "devices.schema.json#/$defs/Device" }
      }
    },
    "DeviceDisconnectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "device.disconnect" },
        "params": { "$ref": "#/$defs/EmptyParams" }
      }
    },
    "DeviceDisconnectResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": { "$ref": "#/$defs/AcceptedResult" }
      }
    },
    "DeviceGetActiveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "device.getActive" },
        "params": { "$ref": "#/$defs/EmptyParams" }
      }
    },
    "DeviceGetActiveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": {
          "oneOf": [{ "$ref": "devices.schema.json#/$defs/Device" }, { "type": "null" }]
        }
      }
    },
    "SavedDevicesListRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "savedDevices.list" },
        "params": { "$ref": "#/$defs/EmptyParams" }
      }
    },
    "SavedDevicesListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": {
          "type": "array",
          "items": { "$ref": "#/$defs/SavedDevice" }
        }
      }
    },
    "SavedDevicesGetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "savedDevices.get" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["savedDeviceId"],
          "properties": { "savedDeviceId": { "type": "string" } }
        }
      }
    },
    "SavedDevicesGetResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": { "$ref": "#/$defs/SavedDevice" }
      }
    },
    "SavedDevicesRenameRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "savedDevices.rename" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["savedDeviceId", "name"],
          "properties": {
            "savedDeviceId": { "type": "string" },
            "name": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "SavedDevicesRenameResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": { "$ref": "#/$defs/SavedDevice" }
      }
    },
    "SavedDevicesForgetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "savedDevices.forget" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["savedDeviceId"],
          "properties": { "savedDeviceId": { "type": "string" } }
        }
      }
    },
    "SavedDevicesForgetResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": { "$ref": "#/$defs/AcceptedResult" }
      }
    },
    "BoardProfilesGetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "boardProfiles.get" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["savedDeviceId"],
          "properties": { "savedDeviceId": { "type": "string" } }
        }
      }
    },
    "BoardProfilesGetResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": { "$ref": "#/$defs/BoardProfile" }
      }
    },
    "BoardProfilesUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "boardProfiles.update" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["savedDeviceId", "expectedRevision", "patch"],
          "properties": {
            "savedDeviceId": { "type": "string" },
            "expectedRevision": { "type": "integer", "minimum": 0 },
            "patch": { "$ref": "#/$defs/SettingsPatch" }
          }
        }
      }
    },
    "BoardProfilesUpdateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": { "$ref": "#/$defs/BoardProfile" }
      }
    },
    "SettingsGetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "settings.get" },
        "params": { "$ref": "#/$defs/EmptyParams" }
      }
    },
    "SettingsGetResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": { "$ref": "#/$defs/Settings" }
      }
    },
    "SettingsUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "settings.update" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedRevision", "patch"],
          "properties": {
            "expectedRevision": { "type": "integer", "minimum": 0 },
            "patch": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "SettingsUpdateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "result": { "$ref": "#/$defs/Settings" }
      }
    },
    "SessionsListRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "common.schema.json#/$defs/JsonRpcId" },
        "method": { "const": "sessions.list" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cursor": { "type": ["string", "null"] },
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
            "filters": { "$ref": "#/$defs/SessionListFilters" },
            "sort": { "$ref": "#/$defs/SessionListSort" }
          }
        }
      }
    },
    "SessionsListResponse": {
      "type": "object",
      "additionalProperties": false,
