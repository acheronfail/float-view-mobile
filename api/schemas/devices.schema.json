{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://float-view.local/api/v1/schemas/devices.schema.json",
  "title": "Float View device API types",
  "$defs": {
    "DeviceState": {
      "type": "string",
      "enum": [
        "discovered",
        "connecting",
        "connected",
        "discovering_services",
        "ready",
        "disconnecting",
        "reconnecting",
        "disconnected",
        "failed"
      ]
    },
    "Device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "name", "state"],
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque backend-issued identifier; never interpret as a MAC address or UUID."
        },
        "name": { "type": "string", "maxLength": 248 },
        "state": { "$ref": "#/$defs/DeviceState" },
        "lastSeenAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$ref": "#/$defs/Device"
}
